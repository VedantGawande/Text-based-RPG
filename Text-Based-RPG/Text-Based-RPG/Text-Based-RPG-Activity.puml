@startuml TextBasedRPGActivity
title Text-Based RPG - Activity Diagram

start
:Create rooms and player;
:Set current room to starting room;

while (Player continues?) is (yes)
  :Enter current room;

  if (Room is a new monster room?) then (yes)
    if (Player alive?) then (yes)
      repeat
        :Display player and monster health;
        :Read battle command;
        if (Command is an attack?) then (yes)
          :Resolve attack accuracy and damage;
          if (Monster alive?) then (yes)
            :Apply attack effect, if any;
            :Monster takes a turn;
          endif
        elseif (Command is use item?) then (yes)
          :Validate and consume health item;
          if (Item used successfully?) then (yes)
            :Monster takes a turn;
          endif
        elseif (Command is inventory?) then (yes)
          :Display inventory;
        else (quit or invalid)
          :Quit battle or request valid command;
        endif
      repeat while (Both player and monster alive\nand player continues?) is (yes)
      if (Monster defeated?) then (yes)
        :Mark monster defeated;
      else (no)
        if (Player defeated?) then (yes)
          :Stop game;
        endif
      endif
    else (no)
      :Stop game;
    endif
  endif

  if (Player continues and is alive?) then (yes)
    :Display room and read command;
    if (Command is look?) then (yes)
      :Display room contents;
    elseif (Command is exits?) then (yes)
      :Display available exits;
    elseif (Command is inventory?) then (yes)
      :Display inventory and health;
    elseif (Command is pick up?) then (yes)
      :Move selected item from room to inventory;
    elseif (Command is drop?) then (yes)
      :Move selected item from inventory to room;
    elseif (Command is use item?) then (yes)
      :Validate and consume health item;
    elseif (Command is sleep in Sleep Room?) then (yes)
      :Restore 1 health up to maximum;
    elseif (Command is valid go direction?) then (yes)
      if (Exit exists?) then (yes)
        :Set current room to exit destination;
      else (no)
        :Stay in current room;
      endif
    elseif (Command is quit?) then (yes)
      :Stop game;
    else (help or invalid)
      :Display help or invalid-command message;
    endif
  endif
endwhile (no)

:End game;
stop
@enduml
