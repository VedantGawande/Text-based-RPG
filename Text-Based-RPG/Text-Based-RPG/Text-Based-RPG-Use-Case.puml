@startuml TextBasedRPGUseCases
title Text-Based RPG - Use Case Diagram
left to right direction
skinparam packageStyle rectangle

actor Player

rectangle "Text-Based RPG" {
  usecase "Start and play game" as Play
  usecase "Explore current room" as Explore
  usecase "View room contents" as Look
  usecase "View available exits" as Exits
  usecase "Navigate to another room" as Navigate
  usecase "View inventory" as Inventory
  usecase "Pick up item" as Pickup
  usecase "Drop item" as Drop
  usecase "Use health item" as UseItem
  usecase "Sleep to restore health" as Sleep
  usecase "View help" as Help
  usecase "Fight monster" as Fight
  usecase "Choose attack" as Attack
  usecase "Use health item during battle" as BattleHeal
  usecase "Quit game" as Quit
}

Player --> Play
Player --> Explore
Player --> Look
Player --> Exits
Player --> Navigate
Player --> Inventory
Player --> Pickup
Player --> Drop
Player --> UseItem
Player --> Sleep
Player --> Help
Player --> Fight
Player --> Quit

Explore ..> Look : <<include>>
Explore ..> Exits : <<include>>
Explore ..> Navigate : <<include>>
Explore ..> Inventory : <<include>>
Explore ..> Pickup : <<include>>
Explore ..> Drop : <<include>>
Explore ..> UseItem : <<include>>
Fight ..> Attack : <<include>>
BattleHeal ..> UseItem : <<include>>
BattleHeal ..> Fight : <<extend>>
Sleep ..> Explore : <<extend>>

note right of Sleep
  Available in the Sleep Room
end note

note right of Fight
  Triggered on entering
  the monster room
end note

@enduml
